<tr id="<%= dom_id(user) %>" class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 p-4 cursor-pointer hover:bg-base-200 focus-within:bg-base-200 sm:table-row sm:p-0" data-controller="user-row" data-action="click->user-row#edit">
  <td class="col-span-2 min-w-0 p-0 sm:p-4">
    <div class="flex items-center gap-3">
      <% if user.avatar.attached? %>
        <div class="avatar shrink-0">
          <div class="size-10 rounded-full">
            <%= image_tag user.avatar, alt: "", class: "object-cover", width: 40, height: 40, loading: "lazy" %>
          </div>
        </div>
      <% else %>
        <div class="avatar avatar-placeholder shrink-0" aria-hidden="true">
          <div class="size-10 rounded-full bg-base-200 text-base-content">
            <span class="text-sm"><%= user.full_name.split.first(2).map { |name| name.first }.join.upcase %></span>
          </div>
        </div>
      <% end %>
      <%= link_to user.full_name, edit_admin_user_path(user), class: "min-w-0 font-semibold [overflow-wrap:anywhere]",
        data: { turbo_stream: true, user_row_target: "link" }, aria: { label: "Edit #{user.full_name}" } %>
    </div>
  </td>
  <td class="col-span-2 min-w-0 pt-1 pr-0 pb-3 pl-13 text-sm text-base-content/70 [overflow-wrap:anywhere] sm:p-4"><%= user.email_address %></td>
  <td class="py-0 pr-0 pl-13 sm:p-4"><span class="badge badge-sm <%= user.admin? ? "badge-secondary" : "badge-info" %>"><%= user.role.humanize %></span></td>
</tr>
