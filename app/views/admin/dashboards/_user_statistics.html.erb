<% users_by_role = User.group(:role).count %>

<dl id="user_statistics" class="stats stats-vertical mt-8 w-full border border-base-300 bg-base-200 sm:stats-horizontal" aria-live="polite" aria-atomic="true">
  <div class="stat">
    <dt class="stat-title text-base-content">Total users</dt>
    <dd id="total_users" class="stat-value text-primary tabular-nums"><%= users_by_role.values.sum %></dd>
  </div>
  <% User.roles.each_key do |role| %>
    <div class="stat">
      <dt class="stat-title text-base-content"><%= role.humanize.pluralize %></dt>
      <dd id="<%= role %>_count" class="stat-value tabular-nums"><%= users_by_role.fetch(role, 0) %></dd>
    </div>
  <% end %>
</dl>
