<% content_for :title, "Import users | Users Dashboard" %>

<%= link_to "Back to users", admin_dashboard_path, class: "btn btn-ghost btn-sm" %>
<h1 class="mt-4 text-3xl font-bold">Import users</h1>
<p class="mt-2 text-sm">Upload a CSV with name and email columns in either order, with or without headers.</p>
<p class="mt-1 text-sm text-base-content/70">Users receive the regular user role and a random password. Admins can set their passwords from the user list.</p>

<%= form_with builder: ApplicationFormBuilder, model: @user_import, url: admin_user_imports_path, html: { novalidate: true }, class: "mt-6 max-w-xl space-y-3" do |form| %>
  <%= form.label :file, "CSV file", class: "block font-medium" %>
  <%= form.file_field :file, accept: ".csv,text/csv", required: true,
    aria: { describedby: "file_help" } %>
  <p id="file_help" class="text-sm text-base-content/70">UTF-8, up to 5 MB. Commas, semicolons, and tabs are supported.</p>
  <%= form.submit "Import users", class: "btn" %>
<% end %>

<% if @imports.any? %>
  <section class="mt-8" aria-labelledby="recent_imports">
    <h2 id="recent_imports" class="text-xl font-semibold">Recent imports</h2>
    <div class="mt-4 divide-y divide-base-300 rounded-box border border-base-300">
      <%= render partial: "user_import", collection: @imports %>
    </div>
  </section>
<% end %>
