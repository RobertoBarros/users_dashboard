<% content_for :title, "User import | Users Dashboard" %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @user_import %>

<%= link_to "Back to users", admin_dashboard_path, class: "btn btn-ghost btn-sm" %>
<h1 class="mt-4 text-3xl font-bold">User import</h1>
<section id="import_progress" class="mt-6 rounded-box border border-base-300 p-5" aria-label="Import progress">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="font-semibold"><%= @user_import.status.humanize %></h2>
    <p class="text-sm tabular-nums"><%= @user_import.processed_count %> / <%= @user_import.total_count %> processed</p>
  </div>
  <progress class="progress mt-4 w-full" value="<%= @user_import.processed_count %>" max="<%= [@user_import.total_count, 1].max %>" aria-label="Users processed"></progress>
  <p class="mt-2 text-sm"><%= @user_import.imported_count %> imported · <%= @user_import.failed_count %> failed</p>
  <% if @user_import.pending? %>
    <p class="mt-2 text-sm text-base-content/70">Waiting for a background worker.</p>
  <% elsif @user_import.processing? %>
    <p class="mt-2 text-sm text-base-content/70">You can leave this page. The import will continue in the background.</p>
  <% end %>
  <% if @user_import.error_message.present? %>
    <p class="mt-3 text-sm text-error" role="alert"><%= @user_import.error_message %></p>
  <% end %>
</section>

<% if @results.any? %>
  <h2 class="mt-8 text-xl font-semibold">Results</h2>
  <div class="mt-4 overflow-x-auto rounded-box border border-base-300">
    <table class="table">
      <thead><tr><th>Row</th><th>User</th><th>Result</th></tr></thead>
      <tbody><%= render partial: "result", collection: @results %></tbody>
    </table>
  </div>
  <% if @pagy.last > 1 %>
    <nav class="mt-4 flex flex-wrap items-center justify-center gap-3" aria-label="Import results pagination">
      <%= link_to "Previous", @pagy.page_url(@pagy.previous), class: "btn btn-sm" if @pagy.previous %>
      <span class="text-sm">Page <%= @pagy.page %> of <%= @pagy.last %></span>
      <%= link_to "Next", @pagy.page_url(@pagy.next), class: "btn btn-sm" if @pagy.next %>
    </nav>
  <% end %>
<% end %>
<% if @user_import.completed? || @user_import.failed? %>
  <%= link_to "Import another CSV", admin_user_imports_path, class: "btn mt-6" %>
<% end %>
