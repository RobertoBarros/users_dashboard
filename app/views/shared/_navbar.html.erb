<nav class="border-b border-base-300 bg-base-200" aria-label="Main navigation">
  <div class="navbar container mx-auto flex-wrap gap-2 px-5">
    <%= link_to "Users Dashboard", root_path, class: "flex-1 text-lg font-semibold whitespace-nowrap" %>
    <% if authenticated? %>
      <% if Current.user.admin? %>
        <%= link_to "Dashboard", admin_dashboard_path, class: "btn btn-ghost" %>
      <% end %>
      <%= link_to "Profile", users_profile_path, class: "btn btn-ghost" %>
      <%= button_to "Log out", session_path, method: :delete, class: "btn btn-ghost" %>
    <% else %>
      <%= link_to "Log in", new_session_path, class: "btn btn-ghost" %>
      <%= link_to "Sign up", new_registration_path, class: "btn btn-primary" %>
    <% end %>
    <%= render "shared/theme_selector" %>
  </div>
</nav>
