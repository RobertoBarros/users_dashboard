<nav class="border-b border-base-300 bg-base-200" aria-label="Main navigation">
  <div class="navbar container mx-auto flex-nowrap gap-1 px-2 sm:gap-2 sm:px-5">
    <%= link_to "Users Dashboard", root_path, class: "hidden flex-1 text-lg font-semibold whitespace-nowrap sm:block" %>
    <% if authenticated? %>
      <% if Current.user.admin? %>
        <%= link_to "Dashboard", admin_dashboard_path, class: "btn btn-ghost px-2 sm:px-4" %>
      <% end %>
      <%= link_to "Profile", users_profile_path, class: "btn btn-ghost px-2 sm:px-4" %>
      <%= button_to "Log out", session_path, method: :delete, class: "btn btn-ghost px-2 sm:px-4" %>
    <% else %>
      <%= link_to "Log in", new_session_path, class: "btn btn-ghost px-2 sm:px-4" %>
      <%= link_to "Sign up", new_registration_path, class: "btn btn-primary" %>
    <% end %>
    <%= render "shared/theme_selector" %>
  </div>
</nav>
