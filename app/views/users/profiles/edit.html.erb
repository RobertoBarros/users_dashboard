<% content_for :title, "Edit profile | Users Dashboard" %>

<div class="mx-auto max-w-sm">
  <h1 class="mb-6 text-3xl font-bold">Edit profile</h1>

  <%= form_with builder: ApplicationFormBuilder, model: @user, url: users_profile_path, method: :patch, html: { novalidate: true }, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :full_name, "Full name", class: "mb-2 block" %>
      <%= form.text_field :full_name, required: true, autocomplete: "name" %>
    </div>
    <div>
      <%= form.label :email_address, "Email", class: "mb-2 block" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username" %>
    </div>
    <div>
      <%= form.label :password, "New password", class: "mb-2 block" %>
      <%= form.password_field :password, autocomplete: "new-password", minlength: 8, maxlength: 72, aria: { describedby: "password-hint" } %>

      <p id="password-hint" class="mt-2 text-sm">Leave blank to keep your current password. Use at least 8 characters for a new password.</p>
    </div>
    <div>
      <%= form.label :password_confirmation, "Confirm new password", class: "mb-2 block" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div>
      <%= form.label :avatar, "Avatar (optional)", class: "mb-2 block" %>
      <%= form.file_field :avatar, accept: "image/jpeg,image/png,image/gif,image/webp", aria: { describedby: "avatar-hint" } %>

      <p id="avatar-hint" class="mt-2 text-sm">Choose a JPEG, PNG, GIF, or WebP image. Leave blank to keep your current avatar.</p>
    </div>
    <%= form.submit "Save changes", class: "btn btn-primary w-full" %>
  <% end %>

  <%= link_to "Cancel", users_profile_path, class: "btn btn-ghost mt-4 w-full" %>
</div>
