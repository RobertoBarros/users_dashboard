<% content_for :title, "Profile | Users Dashboard" %>

<div class="mx-auto max-w-sm">
  <h1 class="mb-6 text-3xl font-bold">Profile</h1>

  <% if @user.avatar.attached? %>
    <div class="avatar mb-6">
      <div class="w-24 rounded-full">
        <%= image_tag @user.avatar, alt: "#{@user.full_name}'s avatar", class: "object-cover", width: 96, height: 96 %>
      </div>
    </div>
  <% else %>
    <div class="avatar avatar-placeholder mb-6" aria-hidden="true">
      <div class="w-24 rounded-full bg-base-200 text-base-content">
        <span class="text-3xl"><%= @user.full_name.split.first(2).map { |name| name.first }.join.upcase %></span>
      </div>
    </div>
  <% end %>

  <dl class="space-y-4">
    <div>
      <dt class="font-semibold">Full name</dt>
      <dd class="mt-1 break-words"><%= @user.full_name.presence || "Not provided" %></dd>
    </div>
    <div>
      <dt class="font-semibold">Email</dt>
      <dd class="mt-1 break-words"><%= @user.email_address %></dd>
    </div>
  </dl>

  <%= link_to "Edit profile", edit_users_profile_path, class: "btn btn-primary mt-6 w-full" %>

  <%= button_to "Delete profile", users_profile_path, method: :delete,
    class: "btn btn-outline btn-error mt-4 w-full",
    form: { data: { turbo_confirm: "Delete your profile permanently? Your account will be removed and you will be signed out. This cannot be undone." } } %>
</div>
